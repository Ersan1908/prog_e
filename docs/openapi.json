            "title": "Earliest Year"
          },
          "latest_year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Year"
          },
          "genres": {
            "items": {
              "$ref": "#/components/schemas/GenreStats"
            },
            "type": "array",
            "title": "Genres"
          }
        },
        "type": "object",
        "required": [
          "total_movies",
          "average_rating",
          "earliest_year",
          "latest_year",
          "genres"
        ],
        "title": "MovieStats"
      },
      "MovieWrite": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "examples": [
              "Тестовый фильм"
            ]
          },
          "director": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Director",
            "examples": [
              "Иван Петров"
            ]
          },
          "year": {
            "type": "integer",
            "maximum": 2100.0,
            "minimum": 1888.0,
            "title": "Year",
            "examples": [
              2024
            ]
          },
          "genre": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Genre",
            "examples": [
              "Драма"
            ]
          },
          "rating": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Rating",
            "examples": [
              8.2
            ]
          },
          "duration_minutes": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Duration Minutes",
            "examples": [
              110
            ]
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 3000
              },
