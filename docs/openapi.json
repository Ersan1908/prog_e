{
  "openapi": "3.1.0",
  "info": {
    "title": "API фильмотеки",
    "description": "Лабораторная работа: разработка REST API. Вариант 5. CRUD фильмов, поиск по названию, фильтры по году, жанру и рейтингу, сортировка, пагинация и статистика. Все тела запросов и ответов используют JSON.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Сервис"
        ],
        "summary": "Проверить API и соединение с БД",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/movies": {
      "get": {
        "tags": [
          "Фильмы"
        ],
        "summary": "Получить список фильмов",
        "description": "Фильтры объединяются условием AND. Поиск учитывает кириллицу.\n\nРейтинг задаётся включительным диапазоном. При равных значениях сортировки\nиспользуется id по возрастанию, чтобы страницы имели стабильный порядок.",
        "operationId": "list_movies_api_v1_movies_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ],
              "description": "Часть названия",
              "title": "Q"
            },
            "description": "Часть названия"
          },
          {
            "name": "year",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 2100,
                  "minimum": 1888
                },
                {
                  "type": "null"
                }
              ],
              "title": "Year"
            }
          },
          {
            "name": "genre",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                {
                  "type": "null"
                }
              ],
              "title": "Genre"
            }
          },
          {
            "name": "rating_min",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 10,
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Rating Min"
            }
          },
          {
            "name": "rating_max",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 10,
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Rating Max"
            }
          },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "id",
                "title",
                "year",
                "rating"
              ],
              "type": "string",
              "default": "id",
              "title": "Sort By"
            }
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string",
              "default": "asc",
              "title": "Order"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000000000,
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 10,
              "title": "Page Size"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MoviePage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Фильмы"
        ],
        "summary": "Добавить фильм",
        "operationId": "create_movie_api_v1_movies_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MovieWrite"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MovieRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/movies/stats": {
      "get": {
        "tags": [
          "Аналитика"
        ],
        "summary": "Получить статистику фильмотеки",
        "operationId": "movie_stats_api_v1_movies_stats_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MovieStats"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/genres": {
      "get": {
        "tags": [
          "Аналитика"
        ],
        "summary": "Получить список используемых жанров",
        "operationId": "list_genres_api_v1_genres_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "title": "Response List Genres Api V1 Genres Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/movies/{movie_id}": {
      "get": {
        "tags": [
          "Фильмы"
        ],
        "summary": "Получить фильм по ID",
        "operationId": "read_movie_api_v1_movies__movie_id__get",
        "parameters": [
          {
            "name": "movie_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "maximum": 9223372036854775807,
              "exclusiveMinimum": 0,
              "description": "Идентификатор фильма",
              "title": "Movie Id"
            },
            "description": "Идентификатор фильма"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MovieRead"
                }
              }
            }
          },
          "404": {
            "description": "Фильм не найден",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Фильмы"
        ],
        "summary": "Полностью обновить фильм",
        "description": "PUT заменяет все редактируемые поля. Пропущенное description станет null.",
        "operationId": "replace_movie_api_v1_movies__movie_id__put",
        "parameters": [
          {
            "name": "movie_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "maximum": 9223372036854775807,
              "exclusiveMinimum": 0,
              "description": "Идентификатор фильма",
              "title": "Movie Id"
            },
            "description": "Идентификатор фильма"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MovieWrite"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MovieRead"
                }
              }
            }
          },
          "404": {
            "description": "Фильм не найден",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Фильмы"
        ],
        "summary": "Удалить фильм",
        "operationId": "delete_movie_api_v1_movies__movie_id__delete",
        "parameters": [
          {
            "name": "movie_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "maximum": 9223372036854775807,
              "exclusiveMinimum": 0,
              "description": "Идентификатор фильма",
              "title": "Movie Id"
            },
            "description": "Идентификатор фильма"
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "Фильм не найден",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "GenreStats": {
        "properties": {
          "genre": {
            "type": "string",
            "title": "Genre"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "average_rating": {
            "type": "number",
            "title": "Average Rating"
          }
        },
        "type": "object",
        "required": [
          "genre",
          "count",
          "average_rating"
        ],
        "title": "GenreStats"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "database": {
            "type": "string",
            "const": "sqlite",
            "title": "Database"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "title": "HealthResponse"
      },
      "MoviePage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/MovieRead"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size"
          },
          "total_pages": {
            "type": "integer",
            "title": "Total Pages"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "page_size",
          "total_pages"
        ],
        "title": "MoviePage"
      },
      "MovieRead": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "examples": [
              "Тестовый фильм"
            ]
          },
          "director": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Director",
            "examples": [
              "Иван Петров"
            ]
          },
          "year": {
            "type": "integer",
            "maximum": 2100.0,
            "minimum": 1888.0,
            "title": "Year",
            "examples": [
              2024
            ]
          },
          "genre": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Genre",
            "examples": [
              "Драма"
            ]
          },
          "rating": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Rating",
            "examples": [
              8.2
            ]
          },
          "duration_minutes": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Duration Minutes",
            "examples": [
              110
            ]
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 3000
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "id": {
            "type": "integer",
            "title": "Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "director",
          "year",
          "genre",
          "rating",
          "duration_minutes",
          "id"
        ],
        "title": "MovieRead"
      },
      "MovieStats": {
        "properties": {
          "total_movies": {
            "type": "integer",
            "title": "Total Movies"
          },
          "average_rating": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Average Rating"
          },
          "earliest_year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
